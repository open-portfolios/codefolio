<component package="components" name="Sidebar">
    <column key="sidebar-wrap" width="42" gap="0" bg="{Theme.BackgroundPanel}">
        <column key="sidebar-content" flex="1" paddingTop="1" paddingLeft="2" paddingRight="2" gap="0" bg="{Theme.BackgroundPanel}">
            <text text="Untitled session" style="bold" fg="{Theme.Text}" bg="{Theme.BackgroundPanel}" />
            <text text="${workDir}" style="dim" fg="{Theme.TextMuted}" bg="{Theme.BackgroundPanel}" />
            <text text="" bg="{Theme.BackgroundPanel}" />
            <text text="Context" style="bold" fg="{Theme.Text}" bg="{Theme.BackgroundPanel}" />
            <text text="0 tokens" fg="{Theme.TextMuted}" bg="{Theme.BackgroundPanel}" />
            <text text="0% used" fg="{Theme.TextMuted}" bg="{Theme.BackgroundPanel}" />
            <text text="$0.00 spent" fg="{Theme.TextMuted}" bg="{Theme.BackgroundPanel}" />
            <text text="" bg="{Theme.BackgroundPanel}" />
            <text text="MCP" style="bold" fg="{Theme.Text}" bg="{Theme.BackgroundPanel}" />
            <text text="${mcp.Label}" fg="{self.MCPColor()}" bg="{Theme.BackgroundPanel}" />
        </column>
        <row key="sidebar-footer" paddingLeft="2" paddingRight="2" bg="{Theme.BackgroundPanel}">
            <text text="● Codefolio" style="dim" fg="{Theme.TextMuted}" bg="{Theme.BackgroundPanel}" />
        </row>
        <text text="" bg="{Theme.BackgroundPanel}" />
    </column>
</component>
