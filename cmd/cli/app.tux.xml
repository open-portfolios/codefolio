<component package="main" name="App">
    <import package="github.com/open-portfolios/codefolio/cmd/cli/components" component="Transcript" />
    <import package="github.com/open-portfolios/codefolio/cmd/cli/components" component="Sidebar" />
    <import package="github.com/open-portfolios/codefolio/cmd/cli/components" component="Prompt" />
    <import package="github.com/open-portfolios/codefolio/cmd/cli/components" component="AskDialog" />
	<import package="github.com/open-portfolios/codefolio/cmd/cli/components" component="ApprovalDialog" />
    <import package="github.com/open-portfolios/codefolio/cmd/cli/components" component="Shell" />

    <Shell>
        <Transcript messages="{self.controller.Messages()}" viewport="${viewport}" frame="{self.spinner.Get(ctx)}" onToggleThinking="{self.controller.ToggleThinking}" onToggleTool="{self.controller.ToggleTool}" />
        <Sidebar workDir="${workDir}" mcp="{self.MCPStatus(ctx)}" />
        <Prompt state="${editor}" onKey="${handleEditorKey}" model="{self.controller.ModelName()}" workDir="${workDir}" disabled="{self.ComposerDisabled()}" focus="{self.FocusComposer()}" />
        <AskDialog open="${askOpen}" ask="{self.controller.Ask()}" onMove="${moveAsk}" onConfirm="${confirmAsk}" onDefaults="${respondDefaults}" />
		<ApprovalDialog open="${approvalOpen}" approval="{self.controller.Approval()}" onAllowOnce="${approveOnce}" onAllowSession="${approveSession}" onDeny="${denyApproval}" />
    </Shell>
</component>
